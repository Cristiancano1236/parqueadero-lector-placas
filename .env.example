# Puerto del servidor
PORT=3000

# HTTPS local (true = forzar HTTPS; false = forzar HTTP; omitir = HTTPS si hay certs/)
HTTPS=true

# JWT (cámbialo en producción)
JWT_SECRET=cambiar_este_secreto_local

# Cifrado de secretos en BD (API Key de Gemini, etc.). Cámbialo en producción.
# Si se omite, se deriva de JWT_SECRET (menos recomendable).
APP_ENCRYPTION_KEY=cambiar_esta_clave_de_cifrado

# Base de datos (local)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=parqueadero
