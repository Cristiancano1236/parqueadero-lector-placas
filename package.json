{
  "name": "parqueadero",
  "version": "1.0.0",
  "description": "Sistema de gestión de parqueadero con lector de placas (Gemini AI)",
  "main": "src/server.js",
  "bin": "src/server.js",
  "pkg": {
    "assets": [
      "public/**/*"
    ],
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": "dist"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "certs": "powershell -ExecutionPolicy Bypass -File scripts/generar-certs.ps1",
    "build": "powershell -ExecutionPolicy Bypass -File scripts/build.ps1",
    "build:clean": "rimraf dist"
  },
  "keywords": [
    "parqueadero",
    "placas",
    "gemini",
    "ocr"
  ],
  "author": "Cristian Cano",
  "license": "ISC",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@google/genai": "^1.52.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.9.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.10",
    "pkg": "^5.8.1",
    "rimraf": "^5.0.7"
  },
  "nodemonConfig": {
    "ignore": ["public/**"]
  }
}
