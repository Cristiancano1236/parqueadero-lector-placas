{
  "name": "parqueadero",
  "version": "1.0.0",
  "description": "Sistema de gestión de parqueadero con lector automático de placas",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "certs": "powershell -ExecutionPolicy Bypass -File scripts/generar-certs.ps1",
    "build": "powershell -ExecutionPolicy Bypass -File scripts/build.ps1",
    "build:clean": "rimraf dist"
  },
  "keywords": [
    "parqueadero",
    "ocr",
    "placas",
    "paddleocr"
  ],
  "author": "Cristian Cano",
  "license": "ISC",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.9.1",
    "onnxruntime-node": "^1.27.0",
    "paddleocr": "^1.2.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.10",
    "rimraf": "^5.0.7"
  }
}
